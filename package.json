{
	"name": "heic-converter",
	"version": "0.2.0",
	"description": "Convert HEIC/HEIF images to PNG or JPG in the browser",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun --port 3000 index.html",
		"build": "bun build ./index.html --outdir dist --minify",
		"typecheck": "tsc --noEmit",
		"lint": "biome check ."
	},
	"dependencies": {
		"heic-to": "^1.6.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "latest",
		"typescript": "^5"
	}
}
